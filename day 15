//program for pre and post incriment and decriment.
import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a = sc.nextInt(); //a=29
		int b,c,d,e;
		
		 b=a++;
		 c=--b;
		 d=c++;
		 e=++d;
		 System.out.println(a + " "+ b+" "+c+" "+d+" "+e);
			
	}
}

