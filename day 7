Amstrong Number :

import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);

        int n = obj.nextInt();
        int temp = n;
        int c = 0;
        int sum = 0;

        // Count digits
        while (n != 0) {
            n = n / 10;
            c++;
        }

        n = temp;

        // Calculate Armstrong sum
        while (n != 0) {
            int d = n % 10;
            sum = sum + (int)Math.pow(d, c);
            n = n / 10;
        }

        // Check
        if (temp == sum)
            System.out.println("Armstrong Number");
        else
            System.out.println("Not Armstrong Number");
    }
}

2 .Strong Number :

import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int temp = n;
        int sum = 0;

        while (n != 0) {
            int d = n % 10;

            int fact = 1;

            for (int i = 1; i <= d; i++) {
                fact = fact * i;
            }

            sum = sum + fact;
            n = n / 10;
        }

        if (sum == temp)
            System.out.println("Strong Number");
        else
            System.out.println("Not a Strong Number");
    }
}

3 Adam Number:

import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int temp = n;
        int rev = 0;

        // Reverse the number
        while (n != 0) {
            int d = n % 10;
            rev = rev * 10 + d;
            n = n / 10;
        }

        int square = temp * temp;
        int revSquare = rev * rev;

        // Reverse the square of reverse
        int revOfSquare = 0;

        while (revSquare != 0) {
            int d = revSquare % 10;
            revOfSquare = revOfSquare * 10 + d;
            revSquare = revSquare / 10;
        }

        if (square == revOfSquare)
            System.out.println("Adam Number");
        else
            System.out.println("Not Adam Number");
    }
}

 Amical Pair :

import java.util.Scanner;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int a = sc.nextInt();
        int b = sc.nextInt();

        int sum1 = 0;
        int sum2 = 0;

        for (int i = 1; i < a; i++) {
            if (a % i == 0)
                sum1 = sum1 + i;
        }

        for (int i = 1; i < b; i++) {
            if (b % i == 0)
                sum2 = sum2 + i;
        }

        if (sum1 == b && sum2 == a)
            System.out.println("Amicable Pair");
        else
            System.out.println("Not Amicable Pair");
    }
}
