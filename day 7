import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter a number: ");
        int originalNumber = sc.nextInt();
        int squareOriginal = originalNumber * originalNumber;
        int temp = originalNumber;
        int reversedNumber = 0;
        while (temp != 0) {
            int digit = temp % 10;
            reversedNumber = (reversedNumber * 10) + digit;
            temp /= 10;
        }
        int squareReversed = reversedNumber * reversedNumber;
        int tempSquare = squareReversed;
        int reversedSquare = 0;
        while (tempSquare != 0) {
            int digit = tempSquare % 10;
            reversedSquare = (reversedSquare * 10) + digit;
            tempSquare /= 10;
        }
        if (reversedSquare == squareOriginal) {
            System.out.println(originalNumber + " is an Adam Number");
        } else {
            System.out.println(originalNumber + " is NOT an Adam Number");
        }
    }
}

